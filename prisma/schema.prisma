generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  BROKER
  AGENCY
  ADMIN
}

enum PropertyPurpose {
  sale
  rent
}

enum PropertyStatus {
  draft
  pending_review
  published
  rejected
}

enum BookingStatus {
  pending
  proposed
  confirmed
  declined
  cancelled
  completed
  no_show
}

enum VisitMode {
  in_person
  video
}

enum LeadStatus {
  open
  replied
  closed
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum AgentStatus {
  onboarding
  pending_review
  active
  rejected
  suspended
}

enum AgencyType {
  individual
  agency
  developer
}

enum AgencyRole {
  owner
  manager
  negotiator
}

enum CredentialType {
  national_id
  tax_number
  business_registration
  real_estate_license
  office_proof
  other
}

enum CredentialStatus {
  pending
  approved
  rejected
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)

  accounts       Account[]
  sessions       Session[]
  membership     AgencyMember?
  sellerProfile  SellerProfile?
  brokerProfile  BrokerProfile?
  properties     Property[]      @relation("ManagedProperties")
  ownedProperties Property[]     @relation("OwnedProperties")
  bookings       Booking[]
  leads          Lead[]
  leadMessages   LeadMessage[]
  wishlist       WishlistItem[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Independent broker — own pipeline, no agency shell. */
model BrokerProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  country        String?
  city           String?
  bio            String?     @db.Text
  title          String?
  languages      String[]
  specialties    String[]
  whatsapp       String?
  status         AgentStatus @default(onboarding)
  statusNote     String?     @db.Text
  onboardingStep Int         @default(0)
  submittedAt    DateTime?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/** Owner who lists their own property (FSBO). Separate from broker/agency. */
model SellerProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  country        String?
  city           String?
  bio            String?     @db.Text
  status         AgentStatus @default(onboarding)
  statusNote     String?     @db.Text
  onboardingStep Int         @default(0)
  submittedAt    DateTime?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agency {
  id                  String      @id @default(cuid())
  name                String?
  type                AgencyType  @default(individual)
  phone               String?
  bio                 String?     @db.Text
  country             String?
  city                String?
  markets             String[]
  status              AgentStatus @default(onboarding)
  statusNote          String?     @db.Text
  onboardingStep      Int         @default(0)
  standardsAcceptedAt DateTime?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?

  members       AgencyMember[]
  credentials   AgentCredential[]
  properties    Property[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AgencyMember {
  id          String     @id @default(cuid())
  agencyId    String
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AgencyRole @default(owner)
  title       String?
  languages   String[]
  specialties String[]
  whatsapp    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model AgentCredential {
  id           String           @id @default(cuid())
  agencyId     String
  agency       Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type         CredentialType
  value        String?
  authority    String?
  jurisdiction String?
  expiresAt    DateTime?
  fileUrl      String?
  status       CredentialStatus @default(pending)
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@unique([agencyId, type])
}

model Property {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String          @db.Text
  address     String
  city        String
  country     String
  price       Int
  purpose     PropertyPurpose
  bedrooms    Int
  bathrooms   Int
  areaSqm     Int
  rating      Float           @default(0)
  reviewCount Int             @default(0)
  categories  String[]
  amenities   String[]
  badges      String[]
  furnished   Boolean         @default(false)
  videoUrl    String?
  lat         Float?
  lng         Float?
  status      PropertyStatus  @default(draft)

  /** Owner of the asset (seller). Null when an agency lists on behalf of an undisclosed owner. */
  sellerId String?
  seller   User?   @relation("OwnedProperties", fields: [sellerId], references: [id])

  /** Representing agency. Null for pure seller (FSBO) listings. */
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  /** Listing manager: broker user or the seller themselves. */
  agentId String
  agent   User   @relation("ManagedProperties", fields: [agentId], references: [id])

  images     PropertyImage[]
  bookings   Booking[]
  leads      Lead[]
  wishlist   WishlistItem[]
  dailyStats PropertyViewDaily[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([agentId])
  @@index([agencyId])
  @@index([sellerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String
  notes      String        @db.Text
  status     BookingStatus @default(pending)
  statusNote String?       @db.Text

  /** Up to three buyer-preferred start times, stored in UTC. */
  slots     DateTime[]
  /** IANA zone the buyer picked the slots in, so both sides read the same wall clock. */
  timezone  String    @default("UTC")
  mode      VisitMode @default(in_person)
  partySize Int       @default(1)

  /** Agreed start time once confirmed, or the host's counter-proposal while `proposed`. */
  visitDate DateTime?

  events BookingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([email])
}

/** Append-only audit of every viewing state change, shown to both sides as a timeline. */
model BookingEvent {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  actorRole String
  actorId   String?
  note      String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([bookingId])
}

model Lead {
  id         String     @id @default(cuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String?
  message    String     @db.Text
  status     LeadStatus @default(open)

  messages     LeadMessage[]
  lastMessageAt DateTime    @default(now())

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([email])
}

/** Replies on an enquiry thread. The opening `Lead.message` is turn zero. */
model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromBuyer Boolean
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Plan {
  id            String         @id
  name          String
  description   String
  priceMonthly  Int
  listingLimit  Int?
  features      String[]
  highlighted   Boolean        @default(false)
  stripePriceId String?
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  agencyId             String
  agency               Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(incomplete)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String    @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model AdminSetting {
  key   String  @id
  value Boolean
}

model PropertyViewDaily {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  views      Int      @default(0)
  leads      Int      @default(0)

  @@unique([propertyId, date])
}
