{
  "name": "real",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -o -- next dev",
    "build": "dotenv -e .env -o -- next build",
    "start": "dotenv -e .env -o -- next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -o -- prisma migrate dev",
    "db:push": "dotenv -e .env -o -- prisma db push",
    "db:seed": "dotenv -e .env -o -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env -o -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
